/target

# Policy config. A real one carries credential references, agent tokens and the
# ACL — `--config`/`IAP_CONFIG` accept any path, so do not anchor to the root.
# The documented template stays tracked.
iap.toml
iap.*.toml
!iap.example.toml

# Audit log, wherever `audit.path` puts it, and the control-plane bearer token
# `run` writes beside it.
audit/
iap-audit.*
*.jsonl
admin-token

# The credentials agent-iap keeps itself. Normally under the state directory and
# nowhere near a checkout, but `[server].secret_store` takes any path and this is
# the one file here that is the credential rather than a reference to one.
secrets.toml
secrets.toml.tmp

# Binaries staged for the container image (see Dockerfile).
/dist
